##############################################################################
# ENVIRONMENT CONFIGURATION - Rental Management System
##############################################################################

# Application Environment
NODE_ENV=development
PORT=5003
HOST=127.0.0.1
APP_URL=http://localhost:5173

# Database Configuration
DB_PATH=./rental_management.db

# Security - JWT & Session (REQUIRED for production)
# Generate secure values with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_key_minimum_64_characters_for_security
SESSION_SECRET=another_very_long_random_secret_key_minimum_64_characters_for_security
JWT_EXPIRE=7d

# File Upload Configuration
UPLOAD_DIR=./src/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Rate Limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
RECOVERY_RATE_LIMIT_MAX=8
RECOVERY_RATE_LIMIT_WINDOW_MS=3600000
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=900000

# Device Lock / Anti-Copy Protection
# Leave empty in development. In production, set this to the fingerprint printed
# by the backend on the intended computer. Multiple fingerprints can be comma-separated.
REQUIRE_DEVICE_LOCK=false
DEVICE_LOCK_FINGERPRINT=
DEVICE_LOCK_FINGERPRINTS=

# Encrypted database backups
BACKUPS_ENABLED=true
BACKUP_DIR=./secure-backups
BACKUP_KEEP_COUNT=14
BACKUP_INTERVAL_HOURS=24
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=

# Default Admin User
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-before-production
DEFAULT_ADMIN_EMAIL=admin@example.com
MIN_PASSWORD_LENGTH=8
DISABLE_PUBLIC_REGISTRATION=false
LOGIN_OTP_ENABLED=false
LOGIN_OTP_ROLES=admin

##############################################################################
# OPTIONAL INTEGRATIONS
##############################################################################

# Google OAuth Authentication
# 1. Create project: https://console.cloud.google.com
# 2. Create OAuth 2.0 credentials (Web Application)
# 3. Set authorized redirect URI to: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email/SMTP Configuration (for password reset, email verification)
# Uses Nodemailer - supports Gmail, SendGrid, custom SMTP, etc.
# Gmail with 2FA: Use "App Password" (16 chars), not regular password
# Gmail: smtp.gmail.com (port 587, SMTP_SECURE=false)
# Office365: smtp.office365.com (port 587, SMTP_SECURE=false)
# SendGrid: smtp.sendgrid.net (port 587, user: apikey)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-not-regular-password
SMTP_FROM_EMAIL=noreply@ubumwerental.com
SMTP_FROM_NAME=UBUMWE RENTAL SYSTEM

# SMS Recovery / OTP Provider (Twilio)
# Required if password recovery should send real SMS messages.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=your-twilio-phone-number

# WhatsApp Automated Reminders
# 1. Set up Meta WhatsApp Business API at: https://www.whatsapp.com/business/
# 2. Get Phone Number ID and Access Token
# 3. Enable only in production when fully tested
WHATSAPP_REMINDERS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta
WHATSAPP_DEFAULT_COUNTRY_CODE=250
WHATSAPP_REMINDER_DAYS_BEFORE=3
WHATSAPP_REMINDER_INTERVAL_HOURS=24
