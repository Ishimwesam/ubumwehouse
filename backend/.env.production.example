NODE_ENV=production
HOST=0.0.0.0
PORT=5003

# Required. Generate strong values before deployment:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret
SESSION_SECRET=replace-with-a-different-strong-random-secret
JWT_EXPIRE=7d

# Public URLs allowed to use the deployed API, comma-separated, no trailing slash.
APP_URL=https://ubumwehouse-prod.onrender.com,https://ubumwehouse.netlify.app

# Persistent server paths. On Render these must stay under the mounted disk path.
PERSISTENT_DB_ROOT=/data
DB_PATH=/data/rental_management.db
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Login security
MIN_PASSWORD_LENGTH=8
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
RECOVERY_RATE_LIMIT_MAX=8
RECOVERY_RATE_LIMIT_WINDOW_MS=3600000
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=900000
ALLOW_DEV_TOKEN=false

# Device lock / anti-copy protection. Production requires this.
# Start once without it to see the fingerprint in the backend error/log,
# then set DEVICE_LOCK_FINGERPRINT to that value on the approved machine.
REQUIRE_DEVICE_LOCK=true
DEVICE_LOCK_FINGERPRINT=replace-with-this-machine-fingerprint
DEVICE_LOCK_FINGERPRINTS=

# Sessions are stored in SQLite automatically in production.

# Encrypted database backups
BACKUPS_ENABLED=true
BACKUP_DIR=/data/secure-backups
BACKUP_KEEP_COUNT=14
BACKUP_INTERVAL_HOURS=24
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-character-secret

# First admin/user seed values. Change before first production run.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-before-production
DEFAULT_ADMIN_EMAIL=ishimwesamuel023@gmail.com
DISABLE_PUBLIC_REGISTRATION=true

# Email recovery and verification, optional but recommended.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth, optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp automated rent reminders, optional.
WHATSAPP_REMINDERS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=250
WHATSAPP_REMINDER_DAYS_BEFORE=3
WHATSAPP_REMINDER_INTERVAL_HOURS=24
