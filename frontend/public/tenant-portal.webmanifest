      "name": "Payments",
      "short_name": "Payments",
      "url": "/tenant-portal/payments"
    },
    {
      "name": "Upload Receipt",
      "short_name": "Receipt",
      "url": "/tenant-portal/upload"
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "url": "/tenant-portal/messages"
    }
  ]
}
