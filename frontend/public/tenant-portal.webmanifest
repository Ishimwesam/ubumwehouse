{
  "name": "UBUMWE Tenant Portal",
  "short_name": "Tenant Portal",
  "description": "Tenant self-service portal for UBUMWE HOUSE LTD.",
  "id": "/tenant-portal",
  "start_url": "/tenant-portal",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8fafc",
  "theme_color": "#0f172a",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/tenant-portal-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/samm.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
